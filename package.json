{
  "name": "skill-manager-plus",
  "version": "1.3.7",
  "description": "Unified skill manager for Claude Code, Codex CLI, and OpenCode",
  "license": "MIT",
  "author": "Omri Kaisari",
  "repository": {
    "type": "git",
    "url": "https://github.com/emanuele/skill-manager.git"
  },
  "homepage": "https://github.com/emanuele/skill-manager#readme",
  "bugs": {
    "url": "https://github.com/emanuele/skill-manager/issues"
  },
  "keywords": [
    "claude",
    "codex",
    "opencode",
    "skills",
    "cli",
    "mcp"
  ],
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "files": [
    "dist/",
    "packs/",
    "templates/",
    "README.md",
    "LICENSE",
    "docs/usage-tracking.md"
  ],
  "bin": {
    "sm": "./dist/bin/sm.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "lint:oxlint": "oxlint src/ bin/",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"bin/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"bin/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm build",
    "prepare": "husky",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "fullscreen-ink": "^0.1.0",
    "gray-matter": "^4.0.3",
    "ink": "^7.1.1",
    "marked": "^18.0.14",
    "rapidfuzz-js": "0.13.0",
    "react": "^19.3.0",
    "simple-git": "^4.0.2",
    "zod": "^4.6.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "oxlint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3"
  }
}
