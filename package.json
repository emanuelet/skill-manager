{
  "name": "skill-manager-plus",
  "version": "1.1.0",
  "description": "Unified skill manager for Claude Code, Codex CLI, and OpenCode",
  "license": "MIT",
  "author": "Omri Kaisari",
  "repository": {
    "type": "git",
    "url": "https://github.com/emanuele/skill-manager.git"
  },
  "homepage": "https://github.com/omrikais/skill-manager#readme",
  "bugs": {
    "url": "https://github.com/omrikais/skill-manager/issues"
  },
  "keywords": [
    "claude",
    "codex",
    "opencode",
    "skills",
    "cli",
    "mcp"
  ],
  "type": "module",
  "files": [
    "dist/",
    "packs/",
    "templates/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "sm": "./dist/bin/sm.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint src/ bin/",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"bin/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"bin/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm build",
    "prepare": "husky",
    "release": "node scripts/release.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@avcodes/skilled": "0.4.0",
    "@iarna/toml": "^2.2.5",
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.0",
    "fullscreen-ink": "^0.1.0",
    "gray-matter": "^4.0.3",
    "ink": "^7.1.1",
    "keyv": "^5.6.0",
    "keyv-file": "^5.3.5",
    "marked": "^18.0.13",
    "rapidfuzz-js": "0.12.0",
    "react": "^19.3.0",
    "simple-git": "^3.36.0",
    "skill-manager-plus": "link:",
    "zod": "^4.6.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tsup": "^8.5.1",
    "typescript": "^6.x",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
